+class QualnameSampleClass:
+    def sample_method(self):
+        pass
+
+    @staticmethod
+    def sample_staticmethod():
+        pass
+
+    @classmethod
+    def sample_classmethod(cls):
+        pass
+
+    class NestedClass:
+        pass
+
+
+def qualname_sample_function():
+    pass
+
+
+class QualnameTests(SimpleTestCase):
+    def test_classes_and_functions(self):
+        self.assertEqual(
+            qualname(QualnameSampleClass),
+            "utils_tests.test_module_loading.QualnameSampleClass",
+        )
+        self.assertEqual(
+            qualname(qualname_sample_function),
+            "utils_tests.test_module_loading.qualname_sample_function",
+        )
+        self.assertEqual(
+            qualname(ValidationError), "django.core.exceptions.ValidationError"
+        )
+        self.assertEqual(
+            qualname(import_string), "django.utils.module_loading.import_string"
+        )
+        self.assertEqual(
+            qualname(QualnameSampleClass.NestedClass),
+            "utils_tests.test_module_loading.QualnameSampleClass.NestedClass",
+        )
+        self.assertEqual(
+            qualname(QualnameSampleClass.sample_method),
+            "utils_tests.test_module_loading.QualnameSampleClass.sample_method",
+        )
+        self.assertEqual(
+            qualname(QualnameSampleClass.sample_staticmethod),
+            "utils_tests.test_module_loading.QualnameSampleClass.sample_staticmethod",
+        )
+        self.assertEqual(
+            qualname(QualnameSampleClass.sample_classmethod),
+            "utils_tests.test_module_loading.QualnameSampleClass.sample_classmethod",
+        )
+        self.assertEqual(qualname(len), "builtins.len")
+
+    def test_invalid_values(self):
+        msg = (
+            "qualname() argument must be a class or function, not "
+            "'QualnameSampleClass'"
+        )
+        with self.assertRaisesMessage(TypeError, msg):
+            qualname(QualnameSampleClass())
+        msg = "qualname() argument must be a class or function, not 'int'"
+        with self.assertRaisesMessage(TypeError, msg):
+            qualname(1)
+        msg = "qualname() argument must be a class or function, not 'str'"
+        with self.assertRaisesMessage(TypeError, msg):
+            qualname("a")
+        msg = "qualname() argument must be a class or function, not 'NoneType'"
+        with self.assertRaisesMessage(TypeError, msg):
+            qualname(None)
+        msg = "qualname() argument must be a class or function, not 'module'"
+        with self.assertRaisesMessage(TypeError, msg):
+            qualname(sys)
+
