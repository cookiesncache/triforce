+def qualname(obj):
+    """
+    Return the fully qualified dotted path of a class or function, as
+    "<module>.<qualname>". Raise TypeError if obj is not a class or function.
+    """
+    if not (
+        isinstance(obj, type)
+        or isinstance(
+            obj, (types.FunctionType, types.BuiltinFunctionType, types.MethodType)
+        )
+    ):
+        raise TypeError(
+            "qualname() argument must be a class or function, not %r"
+            % type(obj).__name__
+        )
+    return f"{obj.__module__}.{obj.__qualname__}"
