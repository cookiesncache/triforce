+class QualnameTests(SimpleTestCase):
+    def test_classes_and_functions(self):
+        class Nested:
+            def method(self):
+                pass
+
+        def nested_function():
+            pass
+
+        tests = [
+            (qualname, "django.utils.module_loading.qualname"),
+            (SimpleTestCase, "django.test.testcases.SimpleTestCase"),
+            (QualnameTests, "utils_tests.test_module_loading.QualnameTests"),
+            (
+                QualnameTests.test_classes_and_functions,
+                "utils_tests.test_module_loading.QualnameTests."
+                "test_classes_and_functions",
+            ),
+            (
+                Nested,
+                "utils_tests.test_module_loading.QualnameTests."
+                "test_classes_and_functions.<locals>.Nested",
+            ),
+            (
+                Nested.method,
+                "utils_tests.test_module_loading.QualnameTests."
+                "test_classes_and_functions.<locals>.Nested.method",
+            ),
+            (
+                nested_function,
+                "utils_tests.test_module_loading.QualnameTests."
+                "test_classes_and_functions.<locals>.nested_function",
+            ),
+            (len, "builtins.len"),
+            (int, "builtins.int"),
+        ]
+        for obj, expected in tests:
+            with self.subTest(obj=obj):
+                self.assertEqual(qualname(obj), expected)
+
+    def test_invalid_values(self):
+        tests = [None, 42, "django.test.SimpleTestCase", SimpleTestCase(), object()]
+        for value in tests:
+            with self.subTest(value=value):
+                msg = f"{value!r} is not a class or function."
+                with self.assertRaisesMessage(TypeError, msg):
+                    qualname(value)
