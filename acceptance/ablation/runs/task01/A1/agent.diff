+def qualname(obj):
+    """
+    Return the fully qualified dotted path of a class or function, e.g.
+    "django.utils.module_loading.qualname". Raise TypeError otherwise.
+    """
+    try:
+        module, name = obj.__module__, obj.__qualname__
+    except AttributeError:
+        raise TypeError(f"{obj!r} is not a class or function.")
+    return f"{module}.{name}"
+
