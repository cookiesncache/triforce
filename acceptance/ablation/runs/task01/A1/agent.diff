 )
 
 
@@ -170,6 +171,62 @@ class ModuleImportTests(SimpleTestCase):
             import_string("")
 
 
+class QualnameTests(SimpleTestCase):
+    def test_classes_and_functions(self):
+        class Nested:
+            def method(self):
+                pass
+
+        def nested_function():
+            pass
+
+        tests = [
+            (import_string, "django.utils.module_loading.import_string"),
+            (qualname, "django.utils.module_loading.qualname"),
+            (SimpleTestCase, "django.test.testcases.SimpleTestCase"),
+            (
+                SimpleTestCase.assertRaisesMessage,
+                "django.test.testcases.SimpleTestCase.assertRaisesMessage",
+            ),
+            (QualnameTests, "utils_tests.test_module_loading.QualnameTests"),
+            (
+                Nested,
+                "utils_tests.test_module_loading."
+                "QualnameTests.test_classes_and_functions.<locals>.Nested",
+            ),
+            (
+                Nested.method,
+                "utils_tests.test_module_loading."
+                "QualnameTests.test_classes_and_functions.<locals>.Nested.method",
+            ),
+            (
+                nested_function,
+                "utils_tests.test_module_loading."
+                "QualnameTests.test_classes_and_functions.<locals>.nested_function",
+            ),
+            (int, "builtins.int"),
+            (len, "builtins.len"),
+        ]
+        for obj, expected in tests:
+            with self.subTest(obj=obj):
+                self.assertEqual(qualname(obj), expected)
+        # Importable paths round-trip.
+        for obj in [import_string, SimpleTestCase, QualnameTests]:
+            with self.subTest(obj=obj):
+                self.assertIs(import_string(qualname(obj)), obj)
+
+    def test_invalid_values(self):
+        tests = [None, "", "django.test.SimpleTestCase", 1, [], object(), self]
+        for value in tests:
+            with self.subTest(value=value):
+                msg = (
+                    "qualname() expects a class or function, got "
+                    f"{type(value).__name__!r}."
+                )
+                with self.assertRaisesMessage(TypeError, msg):
+                    qualname(value)
+
+
