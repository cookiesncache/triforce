index 70f26d7..8bbfc3a 100644
--- a/django/utils/module_loading.py
+++ b/django/utils/module_loading.py
@@ -48,6 +48,19 @@ def import_string(dotted_path):
         return import_target
 
 
+def qualname(obj):
+    """
+    Return the fully qualified dotted path of a class or function, suitable
+    for use with import_string(). Raise TypeError for other objects.
+    """
+    try:
+        return f"{obj.__module__}.{obj.__qualname__}"
+    except AttributeError:
+        raise TypeError(
+            f"qualname() expects a class or function, got {type(obj).__name__!r}."
+        )
+
+
