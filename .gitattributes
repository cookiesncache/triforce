# Shell scripts must stay LF or they break under bash on Windows checkouts.
*.sh text eol=lf
# Markdown carrying verbatim prompt contracts — keep byte-stable across platforms
# so the contract-sync check compares content, not line endings.
*.md text eol=lf
*.json text eol=lf
# Machine-written evidence. The harness rewrites it with LF and parses it with
# awk -F'\t'; a CRLF checkout would put a stray \r in every last field and make
# every run show the file as modified.
*.tsv text eol=lf
acceptance/ablation/corpus/**/*.patch -text
acceptance/ablation/runs/** -text
acceptance/evidence/** -text
